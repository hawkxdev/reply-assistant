          "enum": [
            "customer_reply",
            "upsell_hint"
          ],
          "title": "Field",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Id"
        },
        "predicate": {
          "enum": [
            "name",
            "form",
            "description",
            "price",
            "material",
            "form_kind",
            "container",
            "package_quantity",
            "portion_mass",
            "form_quantity",
            "batch_capacity",
            "section_count",
            "filter_size",
            "goes_with",
            "object_mass",
            "delivery",
            "stock",
            "treatment_result"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "stance": {
          "enum": [
            "affirmed",
            "unknown"
          ],
          "title": "Stance",
          "type": "string"

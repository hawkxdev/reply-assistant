        "field": {
          "enum": [
            "customer_reply",
            "upsell_hint"
          ],
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "enum": [
            "handoff",
            "doctor"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "field",
        "kind"
      ],
      "title": "RequiredAction",
      "type": "object"
    },

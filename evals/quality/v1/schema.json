        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "ru"
          ],
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "language"
      ],
      "title": "Source",
      "type": "object"
    },
    "Sources": {
      "additionalProperties": false,
      "description": "Describe the source collection.",
      "properties": {
        "document_kind": {
          "const": "quality_sources",
          "title": "Document Kind",
          "type": "string"
        },
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "rules_id": {
          "const": "factual-assessment-v1",
          "title": "Rules Id",
          "type": "string"
        },
        "rules_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rules Sha256",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "document_kind",
        "schema_version",
        "rules_id",
        "rules_sha256",
        "sources"
      ],
      "title": "Sources",
      "type": "object"
    },
    "Support": {
      "additionalProperties": false,
      "description": "Describe a predicate boundary.",
      "properties": {
        "predicate": {
          "enum": [
            "name",
            "form",
            "description",
            "price",
            "material",

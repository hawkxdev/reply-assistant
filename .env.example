# Copy to .env and fill in. Values never go into the repository.

# Key of the model provider used by the service
REPLY_ASSISTANT_PROVIDER_API_KEY=

# Base URL of the OpenAI compatible endpoint of that provider
REPLY_ASSISTANT_PROVIDER_BASE_URL=

# Model identifier at that provider
REPLY_ASSISTANT_PROVIDER_MODEL=

# Key of the secondary provider, empty when no fallback is wanted
REPLY_ASSISTANT_FALLBACK_PROVIDER_API_KEY=

# Base URL of the OpenAI compatible endpoint of the secondary provider
REPLY_ASSISTANT_FALLBACK_PROVIDER_BASE_URL=

# Model identifier at the secondary provider
REPLY_ASSISTANT_FALLBACK_PROVIDER_MODEL=

# Whether the secondary provider needs JSON mode instead of a strict schema
REPLY_ASSISTANT_FALLBACK_PROVIDER_JSON_MODE=

# Maximum tokens of one model answer, empty for no cap
REPLY_ASSISTANT_PROVIDER_MAX_OUTPUT_TOKENS=

# Path to the knowledge base file
REPLY_ASSISTANT_KB_PATH=
